+async fn checkpoint_snapshot_keeps_both_outbound_queue_layers_live_and_ordered() {
+    use super::queue::{QueueEntry, TransmitQueue};
+    fn item(id: &str) -> QueueEntry {
+        let mut p = Presence::new(PresenceType::Unavailable);
