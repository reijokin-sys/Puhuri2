+#[derive(Default)]
+struct WakeCounter(std::sync::atomic::AtomicUsize);
+impl futures::task::ArcWake for WakeCounter {
+    fn wake_by_ref(arc_self: &Arc<Self>) {
+        arc_self.0.fetch_add(1, std::sync::atomic::Ordering::SeqCst);
+    }
