+impl std::fmt::Debug for DetachedState {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("DetachedState")
+            .field("sm", &self.sm)
+            .field("pending_count", &self.pending.len())
