+    // Capturing a checkpoint must neither close senders nor consume entries.
+    tx.send(item("newer-channel")).await.unwrap();
+    assert_eq!(
+        ids(&queue.snapshot_pending()),
+        ["older-local", "queued-channel", "newer-channel"]
+    );
